# Firebase Hosting build of the LMS SPA (vite build). Public values only: everything here is either
# inlined into the browser bundle (NEXT_PUBLIC_* / VITE_*) or used to compute hosting-headers.json.
# The deploy shell's environment overrides any line. NEXT_PUBLIC_FIREBASE_* (web config) comes from
# the repo-root .env. See scripts/build-env.ts.

# LMS Hosting site (placeholder until the site is created: owner decision 2).
NEXT_PUBLIC_BASE_URL=https://techdrona-lms-app.web.app
NEXT_PUBLIC_APP_NAME=Tech Drona
# Company website (Firebase Hosting): course catalogue (catalog.json), posters, links.
NEXT_PUBLIC_SITE_URL=https://techdrona-website.web.app
NEXT_PUBLIC_ERRORS_TUNNEL=/api/v1/_errors
NEXT_PUBLIC_ANALYTICS_SCHEMA_VERSION=1

# CSP inputs (not bundled): presigned uploads go to Cloud Storage (S3 interop).
S3_ENDPOINT_URL=https://storage.googleapis.com
