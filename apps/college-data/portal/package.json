{
  "name": "techdrona-outreach-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Tech Drona outreach portal: colleges, branches, ambassadors, targets and enrollments across Andhra Pradesh.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/server.js",
