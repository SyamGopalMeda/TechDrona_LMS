# Non-secret environment for the LMS functions. Copy to `.env.billing-f4fe3` (the Firebase CLI loads
# `.env.<projectId>` from this folder at deploy time). Secrets go to Secret Manager (secrets.txt).
# Use the SAME APP_ENV and testing switches as the VM's server.env (zero behaviour change; the
# demo VM runs fake adapters, which APP_ENV=production refuses at startup).
APP_ENV=REPLACE-same-as-server-env
TD_DISABLE_API_DOCS=true
TD_RUNTIME=firebase
TD_SERVICE_NAME=lms-functions
TD_ROUTER_SET=user
LOG_FORMAT=json
# Public LMS origin (the Hosting site, e.g. https://<lms-site>.web.app or the custom domain).
TD_PUBLIC_BASE_URL=https://REPLACE-lms-site.web.app
TD_ALLOWED_ORIGINS=https://REPLACE-lms-site.web.app
TD_ADMISSIONS_ALLOWED_ORIGINS=https://techdrona-website.web.app
TD_WEBSITE_URL=https://techdrona-website.web.app
TD_COOKIE_SECURE=true
# Edge: pack session/device/remember/csrf into __session (Hosting forwards only that cookie).
TD_EDGE_COOKIE_PACKING=session
# Hosting -> function X-Forwarded-For hops: VERIFY on the first deploy (platform.md, unverified #2).
TD_TRUSTED_PROXY_HOPS=1
# Firestore (Application Default Credentials of the function service account; no key file).
# FIREBASE_PROJECT_ID: not settable here (Cloud Functions reserve FIREBASE_*); taken from GOOGLE_CLOUD_PROJECT.
FIRESTORE_DATABASE_ID=(default)
TD_CACHE_BACKEND=firestore
TD_TASKS_BACKEND=cloudtasks
TD_CLOUD_TASKS_LOCATION=asia-south1
# Files: Cloud Storage via S3 interoperability (HMAC key in secrets AWS_ACCESS_KEY_ID/SECRET).
# Buckets: create them with functions-lms/deploy/create-buckets.sh (us-central1 = free tier;
# docs/firebase/agents/cost-media.md section 4).
S3_ENDPOINT_URL=https://storage.googleapis.com
AWS_REGION=auto
S3_BUCKET_UPLOADS=REPLACE-td-uploads
S3_BUCKET_CONTENT=REPLACE-td-content
S3_BUCKET_CERTIFICATES=REPLACE-td-certificates
S3_BUCKET_EXPORTS=REPLACE-td-exports
# Webhooks stay inline (no broker hop needed).
TD_COMMERCE_WEBHOOK_MODE=inline
# Judge: every submission enqueues a Cloud Task (coding.judge_submission -> lmsTasks); the
# lmsJobCodingProcessPending scheduled function sweeps every minute as the backstop.
TD_CODING_SEND_TASKS=1

# 0 = no always-on server (free tier; the first request after ~15 idle minutes takes a few seconds).
# Set 1 once there are daily users (~₹1,500/month) to remove that first-request wait.
LMS_API_MIN_INSTANCES=0
# No Postgres on Firebase (owner decision 2026-11-12): empty DATABASE_URL and every module on
# Firestore. app.core.runtime.postgres_enabled() is then False: no engine, readiness pings Firestore.
DATABASE_URL=
TD_STORE_ADMIN=firestore
TD_STORE_ADMISSIONS=firestore
TD_STORE_AI=firestore
TD_STORE_ANALYTICS=firestore
TD_STORE_ASSESSMENTS=firestore
TD_STORE_AUDIT=firestore
TD_STORE_CATALOG=firestore
TD_STORE_CODING=firestore
TD_STORE_COMMERCE=firestore
TD_STORE_CORE=firestore
TD_STORE_ENGAGE=firestore
TD_STORE_ENTITLEMENTS=firestore
TD_STORE_HUB=firestore
TD_STORE_IDENTITY=firestore
TD_STORE_LEARNING=firestore
TD_STORE_MEDIA=firestore
TD_STORE_MENTORING=firestore
TD_STORE_NOTIFICATIONS=firestore
TD_STORE_ORGS=firestore
TD_STORE_PATHS=firestore
TD_STORE_PLACEMENT=firestore
TD_STORE_RBAC=firestore
TD_STORE_SECURITY=firestore
TD_STORE_SESSIONS=firestore
TD_STORE_SUPPORT=firestore

# College Data Portal (/college-portal/** -> lmsApi -> Cloud Run college-portal; lms_edge/college_portal.py).
# The shared secret is Secret Manager TD_COLLEGE_PORTAL_SECRET (secrets.txt). Requests carry a Google ID token (run.invoker).
TD_COLLEGE_PORTAL_URL=https://college-portal-REPLACE.asia-south1.run.app
