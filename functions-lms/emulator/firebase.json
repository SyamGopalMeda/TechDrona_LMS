{
  "functions": [
    {
      "source": "..",
      "codebase": "lms",
      "runtime": "python313",
      "ignore": ["venv", "__pycache__", "*.pyc", "tools", "deploy", "emulator", ".env.example", ".gitignore"]
    }
  ],
  "hosting": {
    "public": "../../apps/lms-spa/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "lmsApi", "region": "asia-south1" } },
      { "source": "/sitemap.xml", "function": { "functionId": "lmsApi", "region": "asia-south1" } },
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "emulators": {
    "singleProjectMode": true,
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "hosting": { "host": "127.0.0.1", "port": 5000 },
    "hub": { "host": "127.0.0.1", "port": 14402 },
    "logging": { "host": "127.0.0.1", "port": 14502 },
    "ui": { "enabled": false }
  }
}
