# =============================================================================
# Tech Drona LMS — environment template (.env.example)
# Status: Planned (blueprint stage). See docs/deployment-and-operations.md §10.
# Changelog:
#   v0.1 2026-11-03  initial template (DevOps, wave 2)
#   v0.2 2026-11-03  consistency pass: CSRF key web-only (IPR-ENV-01);
#        DATABASE_MAINTENANCE_URL for td_maintenance (IPR-ENV-02); webhook tolerance
#        is monitoring/Cashfree-only, never an age rejection (IPR-ENV-03, CPR-DEP-11);
#        error tracking = self-hosted GlitchTip in ap-south-1, no Sentry SaaS
#        (IPR-ENV-04, ADR-0014); versioned HMAC keys TD_K_DEVICE_KEY_V{n} /
#        TD_K_LOGIN_KEY_V{n} + *_ACTIVE_VERSION (CPR-DEP-03); worker-maintenance.
#   v0.3 2026-11-03  Stage 10: commerce seller/GST + RAZORPAY_ACCOUNT_ID, judge test-case
#        keyring TD_K_TESTCASE_KEY_V{n}, audit-sealer tuning, TD_MAX_BODY_BYTES,
#        TD_DB_SET_ROLE, AWS_SESSION_TOKEN (every Settings field now listed).
#   v0.4 2026-11-03  audit COM-18: added TD_COMMERCE_WEBHOOK_MODE, SELLER_ADDRESS,
#        COMMERCE_DOCUMENT_STORE, TD_CSP_UPLOAD_ORIGINS, NEXT_PUBLIC_APP_VERSION,
#        NEXT_PUBLIC_NOTICE_VERSION, TD_API_WEBHOOKS_HOST_PORT; names no code reads yet are
#        tagged [NOT READ YET]; MinIO root credentials removed (SeaweedFS replaced MinIO).
#   v0.5 2026-11-03  audit fix wave 3: TD_CSP_VDOCIPHER_UPLOAD_ORIGINS (web); AWS_REGION,
#        S3_BUCKET_UPLOADS and S3_BUCKET_CONTENT also read by web (CSP connect-src /
#        form-action); judge_* queues described as opt-in (no consumer by default).
#
# HOW TO USE
#   local:   cp .env.example .env   and keep the local defaults below.
#   dev/staging/prod: DO NOT use .env files. Non-secret values come from the
#            ECS task definition / SSM Parameter Store (Terraform). Values marked
#            [SECRET] are injected by ECS from AWS Secrets Manager (by ARN).
#
# LEGEND (on each variable)
#   [REQUIRED]  service fails to start without it (in the services listed)
#   [OPTIONAL]  has a safe default
#   [SECRET]    must come from AWS Secrets Manager in every non-local env;
#               never commit a real value, never log it, never bake into images
#   [NOT READ YET] documented for a planned feature; no code reads it today, so
#               setting it has no effect (keep the name so docs/infra stay aligned)
#   Services:   api = FastAPI (user routes) · webhooks = api-webhooks
#               workers = Celery worker-* · scheduler = celery beat
#               worker-maintenance = Celery worker with CELERY_QUEUES=maintenance
#               sealer = audit-sealer · migrate = one-off Alembic task
#               web = Next.js BFF · judge = worker-judge (judge-gateway)
#
# ALL VALUES BELOW ARE PLACEHOLDERS. Nothing here is a real credential.
# Product policy values (timeouts, device caps, risk thresholds, retention)
# are NOT env vars — they live in the `policy_settings` table (brief §1).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Runtime / common  (all services)
# -----------------------------------------------------------------------------
# [REQUIRED] local | dev | staging | prod
APP_ENV=local
# [REQUIRED] Logical service name used in logs/traces: api | api-webhooks |
# worker-critical | worker-default | worker-maintenance | worker-judge |
# worker-notifications | worker-analytics | worker-reports | scheduler |
# audit-sealer | migrate | web
TD_SERVICE_NAME=api
# [REQUIRED: api, webhooks] Which routers this api process mounts: user | webhooks
TD_ROUTER_SET=user
# [OPTIONAL] Release identifier (git SHA / tag); set by CI
TD_RELEASE=local-dev
# [OPTIONAL] DEBUG | INFO | WARNING | ERROR   (DEBUG forbidden in prod)
LOG_LEVEL=INFO
# [OPTIONAL] json | console   (json in all non-local envs)
LOG_FORMAT=console
# [REQUIRED] Storage/process timezone is always UTC (ADR-0012)
TZ=UTC
# [REQUIRED] AWS region (data must stay in India). Also read by web: with
# S3_BUCKET_UPLOADS / S3_BUCKET_CONTENT it derives the CSP connect-src/form-action bucket
# origins (https://<bucket>.s3.<region>.amazonaws.com) unless TD_CSP_UPLOAD_ORIGINS is set.
AWS_REGION=ap-south-1
# Local only: credentials for MinIO / LocalStack. In AWS, tasks use IAM task roles —
# NEVER set AWS access keys in non-local environments.
AWS_ACCESS_KEY_ID=local-minio-REPLACE
AWS_SECRET_ACCESS_KEY=local-minio-secret-REPLACE
# [OPTIONAL] Only for temporary STS credentials outside AWS (never set in ECS)
AWS_SESSION_TOKEN=


# -----------------------------------------------------------------------------
# 2. Public URLs and internal routing
# -----------------------------------------------------------------------------
# [REQUIRED: api, web, workers] Public origin (single origin; BFF same-origin model)
TD_PUBLIC_BASE_URL=http://localhost:3000
# [OPTIONAL: api, workers] Base URL of the web app used for links in emails and API responses
# (/verify/email/{token}, /reset-password/{token}, /forgot-password).
# Falls back to TD_PUBLIC_BASE_URL when empty.
WEB_BASE_URL=http://localhost:3000
# [REQUIRED: web] Internal URL of the api service (private network only)
TD_API_INTERNAL_URL=http://localhost:8000
# (API_INTERNAL_URL is accepted by the web BFF as an alias of TD_API_INTERNAL_URL)
# [OPTIONAL: api] Disable /docs and /openapi.json (MUST be true in prod — arch §21)
TD_DISABLE_API_DOCS=false
# [REQUIRED: api, web] [SECRET] Service credential BFF -> API (Authorization: Service <token>)
TD_SERVICE_TOKEN=local-service-token-REPLACE-with-64-random-hex
# [OPTIONAL: api] [SECRET] Previous service token accepted during rotation (24 h window)
TD_SERVICE_TOKEN_PREVIOUS=
# [OPTIONAL: web] [SECRET] CloudFront->ALB origin-verify header value. Enforced by the ALB
# listener rule in AWS; web re-checks it only as defence in depth (empty = check skipped locally)
TD_ORIGIN_VERIFY_HEADER=
# [OPTIONAL: api] Max request body size accepted by the api (bytes; uploads go direct to S3)
TD_MAX_BODY_BYTES=262144


# -----------------------------------------------------------------------------
# 3. PostgreSQL (RDS PostgreSQL 16)  — roles per docs/database-schema.md §1.2
#    Use sslmode=verify-full in AWS (RDS CA bundle path below).
# -----------------------------------------------------------------------------
# [REQUIRED: api, webhooks, workers, scheduler] [SECRET] Runtime role td_app (RLS FORCE applies)
DATABASE_URL=postgresql+asyncpg://td_app:local_app_pw_REPLACE@localhost:5432/techdrona
# [OPTIONAL: api, worker-reports] [SECRET] Read replica, role td_readonly (dashboards, exports)
# Falls back to DATABASE_URL-equivalent primary with td_readonly if empty (pilot has no replica).
DATABASE_READ_URL=postgresql+asyncpg://td_readonly:local_ro_pw_REPLACE@localhost:5432/techdrona
# [REQUIRED: worker with CELERY_QUEUES=maintenance ONLY] [SECRET] Role td_maintenance: EXECUTE on maint.* only
# (partition premake/drops and retention purges via SECURITY DEFINER functions; secret db/td_maintenance)
DATABASE_MAINTENANCE_URL=postgresql+psycopg://td_maintenance:local_maint_pw_REPLACE@localhost:5432/techdrona
# [REQUIRED: migrate ONLY] [SECRET] Owner role td_owner (DDL). Never give to app services.
# Alembic history lives at apps/api/migrations (ADR-0009).
DATABASE_MIGRATION_URL=postgresql+psycopg://td_owner:local_owner_pw_REPLACE@localhost:5432/techdrona
# [REQUIRED: sealer ONLY] [SECRET] Audit sealer role td_audit_sealer
DATABASE_AUDIT_SEALER_URL=postgresql+asyncpg://td_audit_sealer:local_sealer_pw_REPLACE@localhost:5432/techdrona
# [OPTIONAL] Pool sizing PER PROCESS (connection budget, arch §19.2). Peak connections per
# service = uvicorn/celery processes x (DB_POOL_SIZE + DB_MAX_OVERFLOW); keep the sum of all
# services below Postgres/RDS max_connections. When the pool is exhausted for
# DB_POOL_TIMEOUT_SECONDS the api answers 503 service_unavailable + Retry-After (not 500).
# These values apply to host runs (run-api, tests). docker-compose's `api` service overrides
# them with TD_API_WORKERS (4), TD_API_DB_POOL_SIZE (20), TD_API_DB_MAX_OVERFLOW (5) and
# TD_API_DB_POOL_TIMEOUT_SECONDS (5); Postgres there runs with TD_PG_MAX_CONNECTIONS (200).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=5
# [OPTIONAL] Liveness check per pool checkout (asyncpg: BEGIN + ";" + ROLLBACK, 3 round trips).
# Keep true in AWS (RDS failover); false trades that for DB_POOL_RECYCLE_SECONDS only.
DB_POOL_PRE_PING=true
# [OPTIONAL] Replace pooled connections older than this many seconds (-1 = never)
DB_POOL_RECYCLE_SECONDS=1800
# [OPTIONAL] Per-statement timeout for td_app sessions (ms)
DB_STATEMENT_TIMEOUT_MS=15000
# [OPTIONAL] disable | require | verify-full   (verify-full in AWS)
# [NOT READ YET] no code reads this today
DB_SSLMODE=disable
# [OPTIONAL] Path to RDS CA bundle inside the image (AWS only)
# [NOT READ YET] no code reads this today
DB_SSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem
# [OPTIONAL] asyncpg prepared-statement cache; set 0 only if a pooler/RDS Proxy is introduced
DB_STATEMENT_CACHE_SIZE=100
# [OPTIONAL] Test/tooling only: SET ROLE to this plain identifier after connect (empty = off)
TD_DB_SET_ROLE=


# -----------------------------------------------------------------------------
# 4. Redis (ElastiCache) — TWO clusters (brief §1). rediss:// (TLS) in AWS.
# -----------------------------------------------------------------------------
# [REQUIRED: api, workers, scheduler, web(optional)] [SECRET] cache cluster (allkeys-lru)
REDIS_CACHE_URL=redis://localhost:6379/0
# [REQUIRED: api, webhooks, workers, scheduler, sealer] [SECRET] queue cluster (noeviction) — Celery broker + Streams
REDIS_QUEUE_URL=redis://localhost:6380/0
# In AWS the AUTH token is part of the URL (rediss://user:token@host:6379/0) and comes from Secrets Manager.


# -----------------------------------------------------------------------------
# 5. Celery workers / scheduler
# -----------------------------------------------------------------------------
# [REQUIRED: workers] Queues this worker consumes, e.g.
#   critical | default | maintenance (worker-maintenance only; needs DATABASE_MAINTENANCE_URL) |
#   notifications | analytics | reports
# judge_assessment,judge_submit,judge_run are opt-in only (TD_CODING_SEND_TASKS=1) and have
# NO consumer by default: worker-judge is the DB poller `python -m app.modules.coding.worker`,
# not a Celery worker (section 11). Do not list judge_* here unless you deploy a consumer.
# Local: one worker for everything except maintenance; run a second worker with
# CELERY_QUEUES=maintenance to exercise retention/partition jobs.
CELERY_QUEUES=critical,default,notifications,analytics,reports
# [OPTIONAL: workers] Concurrency per task
CELERY_CONCURRENCY=4
# [OPTIONAL] Must exceed the longest task runtime (seconds)
# [NOT READ YET] no code reads this today
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
# [OPTIONAL: scheduler] Redis leader-lock TTL for the single beat
TD_SCHEDULER_LEADER_LOCK_TTL_SECONDS=30
# [OPTIONAL: scheduler] false disables the beat leader lock (single-replica dev only)
TD_SCHEDULER_LEADER_LOCK_ENABLED=true
# [OPTIONAL: worker] liveness file touched by the worker timer (container healthcheck);
# empty = <tmpdir>/td-celery-worker.alive
TD_WORKER_HEALTH_FILE=
TD_WORKER_HEALTH_INTERVAL_SECONDS=15
# [OPTIONAL: scheduler, workers] Outbox relay (Celery task td.core.outbox_relay, queue critical):
# beat interval, rows per run, attempts before an event is left as a dead letter (last_error set)
TD_OUTBOX_RELAY_INTERVAL_SECONDS=5
TD_OUTBOX_RELAY_BATCH=200
TD_OUTBOX_MAX_ATTEMPTS=10
# [OPTIONAL: scheduler, workers] Also seal the audit chain from beat (td.core.audit_seal, queue
# critical; worker then needs DATABASE_AUDIT_SEALER_URL). Set false where the dedicated
# audit-sealer service runs (AWS).
TD_AUDIT_SEALER_BEAT_ENABLED=true
# [OPTIONAL: sealer] Dedicated audit-sealer loop: sleep between empty polls (s) and rows per seal
TD_AUDIT_SEALER_INTERVAL_SECONDS=2
TD_AUDIT_SEALER_BATCH=500


# -----------------------------------------------------------------------------
# 6. Sessions, CSRF, device and identifier keys  (CSRF key: web only, ADR-0010)
#    All are 256-bit random values (hex). Generate locally with:
#      python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
# [REQUIRED: web] [SECRET] Key for signed double-submit CSRF token (td_csrf).
# Minted and validated by the BFF only; the api service never holds this key.
TD_CSRF_KEY=local-csrf-key-REPLACE-with-64-hex
# [OPTIONAL: web] [SECRET] Previous CSRF key accepted during rotation
TD_CSRF_KEY_PREVIOUS=
#
# Versioned HMAC keys (RE §1.5; ops doc §10.2, RB-13). One variable per retained
# version: TD_K_DEVICE_KEY_V1, TD_K_DEVICE_KEY_V2, ... In AWS each comes from the
# secret td/k_device/v{n} (or td/k_login/v{n}), readable by api and worker-* only.
# The active version in AWS is the policy key security.keys.k_device.current_version
# (security.keys.k_login.current_version); *_ACTIVE_VERSION is the local/bootstrap
# default and the app refuses to start if the active version's key is not loaded.
# [REQUIRED: api, workers] [SECRET] k_device v1: HMAC key for devices.device_key_hash (key_version = 1)
TD_K_DEVICE_KEY_V1=local-device-hmac-v1-REPLACE-with-64-hex
# [OPTIONAL: api, workers] Version used for new hashes (older versions: lookup + re-hash in place)
TD_K_DEVICE_ACTIVE_VERSION=1
# [REQUIRED: api, workers] [SECRET] k_login v1: HMAC key for login_attempts.identifier_hash (key_version = 1)
TD_K_LOGIN_KEY_V1=local-login-hmac-v1-REPLACE-with-64-hex
# [OPTIONAL: api, workers] Version used for new hashes (searches cover all loaded versions; never re-hashed)
TD_K_LOGIN_ACTIVE_VERSION=1
# [OPTIONAL: api] [SECRET] Phase 2 only: fingerprint HMAC key for the current epoch (risk.fingerprint.enabled=false by default)
# [NOT READ YET] no code reads this today
TD_FP_HMAC_KEY=
TD_FP_EPOCH=0
# [OPTIONAL: api] Cookie Secure flag; MUST be true outside local (__Host- cookies require HTTPS)
TD_COOKIE_SECURE=false
# [REQUIRED: api] KMS key (alias/ARN) for envelope encryption of TOTP secrets (td-app-envelope).
# Local: "local" uses a static dev key below — never valid outside APP_ENV=local.
TD_APP_ENVELOPE_KMS_KEY_ID=local
# [REQUIRED local only] [SECRET] Dev-only envelope key used when TD_APP_ENVELOPE_KMS_KEY_ID=local
TD_LOCAL_ENVELOPE_KEY=local-envelope-key-REPLACE-with-64-hex
# [REQUIRED: api, workers] [SECRET] k_totp v1: AES-256-GCM key (64 hex chars) encrypting
# mfa_factors.totp_secret_encrypted as "v{n}:nonce:ciphertext". One variable per retained
# version (TD_K_TOTP_KEY_V2, ...); in AWS from secret td/k_totp/v{n}. Production refuses
# non-hex placeholders; if no version is set at all, non-production derives a dev key from
# TD_LOCAL_ENVELOPE_KEY. Rotation: add V{n+1}, set ACTIVE_VERSION, then run
# `python -m app.modules.identity.reencrypt_totp --apply` (also converts legacy pre-GCM rows).
# KMS wrapping of this key (TD_APP_ENVELOPE_KMS_KEY_ID) is a later infra task.
TD_K_TOTP_KEY_V1=local-totp-aes-v1-REPLACE-with-64-hex
# [OPTIONAL: api, workers] Version used for new ciphertexts (all loaded versions decrypt)
TD_K_TOTP_ACTIVE_VERSION=1
# [OPTIONAL: api] WebAuthn relying party (passkeys)
# [NOT READ YET] no code reads this today
TD_WEBAUTHN_RP_ID=localhost
TD_WEBAUTHN_RP_NAME=Tech Drona


# -----------------------------------------------------------------------------
# 7. Analytics / pseudonymisation  (worker-analytics, worker-reports)
# -----------------------------------------------------------------------------
# [REQUIRED: worker-analytics, worker-reports] [SECRET] k_analytics_vN for subject_key = HMAC-SHA256(k, user_id)
# [NOT READ YET] no code reads this today
TD_ANALYTICS_SUBJECT_KEY=local-analytics-key-REPLACE-with-64-hex
# [REQUIRED: same] Version N of the key above (rotated yearly)
TD_ANALYTICS_SUBJECT_KEY_VERSION=1
# [OPTIONAL: api] Redis Stream name for ingest
# [NOT READ YET] no code reads this today
TD_ANALYTICS_STREAM=analytics:ingest


# -----------------------------------------------------------------------------
# 8. Object storage (S3 / MinIO) and CloudFront
# -----------------------------------------------------------------------------
# [OPTIONAL] Local MinIO endpoint; leave EMPTY in AWS
S3_ENDPOINT_URL=http://localhost:9000
# [REQUIRED: api, workers, web] Bucket names (prod names end with -prod). web reads
# S3_BUCKET_UPLOADS and S3_BUCKET_CONTENT (with AWS_REGION) for the CSP connect-src /
# form-action of browser direct uploads; the web task definition must set them too.
# Bucket CORS on both buckets must allow POST from the web origin.
S3_BUCKET_UPLOADS=local-td-uploads
S3_BUCKET_CONTENT=local-td-content
S3_BUCKET_CERTIFICATES=local-td-certificates
S3_BUCKET_EXPORTS=local-td-exports
# [OPTIONAL: api, workers] Report/GST export store: s3 | fake (unset -> s3 in production, fake elsewhere;
# fake is refused at startup in production)
TD_EXPORT_STORE=
# [OPTIONAL: dev/test] Directory for the fake export store (default: <tmp>/td-exports)
TD_EXPORT_FAKE_DIR=
# [OPTIONAL: api] 1 = API sends export jobs to Celery directly (needs broker); unset = the
# analytics.exports_sweep beat entry picks them up within a minute
TD_EXPORTS_SEND_TASKS=
# [OPTIONAL: api] 1 = API wakes the judge worker via Celery on run/submit (needs broker);
# unset = the worker polls queued submissions (the DB row is the source of truth)
TD_CODING_SEND_TASKS=
# [REQUIRED: judge, api(author upload)] Envelope-encrypted hidden test blobs
# [NOT READ YET] no code reads this today
S3_BUCKET_JUDGE_PRIVATE=local-td-judge-private
# [REQUIRED: sealer] Object Lock bucket for audit chain-head anchors
# [NOT READ YET] no code reads this today
S3_BUCKET_AUDIT_ANCHOR=local-td-audit-anchor
# [REQUIRED: api, workers] KMS key for S3 SSE-KMS (alias); "local" disables SSE-KMS on MinIO
S3_KMS_KEY_ID=local
# [REQUIRED in AWS: api, workers] CloudFront domain for signed URLs
# [NOT READ YET] no code reads this today
CLOUDFRONT_DOMAIN=localhost:9000
# [REQUIRED in AWS: api, workers] CloudFront key group public key id
# [NOT READ YET] no code reads this today
CLOUDFRONT_KEY_PAIR_ID=K_REPLACE_KEY_ID
# [REQUIRED in AWS: api, workers] [SECRET] PEM private key for CloudFront signed URLs (\n-escaped)
# [NOT READ YET] no code reads this today
CLOUDFRONT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_LOCAL_PLACEHOLDER\n-----END PRIVATE KEY-----
# [OPTIONAL] Signed URL TTL (arch §12: 5 min)
# [NOT READ YET] no code reads this today
SIGNED_URL_TTL_SECONDS=300
# [OPTIONAL] Max upload size for presigned POST (bytes)
# [NOT READ YET] no code reads this today
UPLOAD_MAX_BYTES=26214400


# -----------------------------------------------------------------------------
# 9. Payments — Razorpay (primary) and Cashfree (fallback)  (ADR-0006)
#    Test-mode keys in local/dev/staging; live keys ONLY in prod Secrets Manager.
# -----------------------------------------------------------------------------
# [REQUIRED: api, webhooks, worker-critical] razorpay | cashfree | fake
# fake = DEV/TEST in-memory Razorpay simulation (refused at startup in production); use it
# locally until Razorpay test-mode keys exist. With fake, COM-01 orders carry
# checkout.test_payment {payment_id, signature} so the web "Simulate a successful payment"
# dialog completes checkout through the real COM-06 verify (stateless across api workers).
# Setting razorpay with the placeholder keys below makes every paid checkout fail with 503.
PAYMENTS_PRIMARY_PROVIDER=fake
# [OPTIONAL] Feature switch for fallback checkout (RB-02)
PAYMENTS_FALLBACK_PROVIDER_ENABLED=false
# [REQUIRED: api, worker-critical] Razorpay key id (returned to the browser with an order; not a secret by itself)
RAZORPAY_KEY_ID=rzp_test_xxx_REPLACE
# [REQUIRED: api, worker-critical] [SECRET] Razorpay key secret (server-side API calls)
RAZORPAY_KEY_SECRET=rzp_test_secret_xxx_REPLACE
# [REQUIRED: webhooks] [SECRET] Razorpay webhook signing secret (HMAC-SHA256 of raw body)
RAZORPAY_WEBHOOK_SECRET=whsec_local_xxx_REPLACE
# [OPTIONAL: webhooks] [SECRET] Previous webhook secret during rotation (1 h window)
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# [OPTIONAL: api, webhooks] Razorpay merchant account id (acc_...) used for reconciliation/routing
RAZORPAY_ACCOUNT_ID=acc_local_REPLACE
# [OPTIONAL] Razorpay REST base URL (override only for a mock server)
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# [OPTIONAL] Cashfree fallback (sandbox locally)
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=cf_test_app_id_REPLACE
# [SECRET] Cashfree secret key (also used to verify Cashfree webhook signatures)
CASHFREE_SECRET_KEY=cf_test_secret_REPLACE
# [OPTIONAL] Webhook staleness threshold (seconds). Monitoring only: events older than
# this are flagged is_stale. Applies only to providers that sign a timestamp (Cashfree):
# such payloads are not trusted and are applied only from a server-side re-fetch.
# Razorpay events are never rejected by age — stale events are re-fetched (ADR-0006).
# No webhook is ever rejected for age. Runtime value: policy key
# commerce.webhook.tolerance_seconds (this env var is the bootstrap default).
WEBHOOK_TOLERANCE_SECONDS=300
# [REQUIRED in prod: api, worker-critical] GST invoice seller identity (CGST/SGST vs IGST
# split = SELLER_STATE_CODE vs buyer state). Placeholders below are NOT a real GSTIN.
SELLER_GSTIN=36AAAAA0000A1Z5
SELLER_STATE_CODE=36
# [OPTIONAL: api, web] Display name of the single operating company (single-company mode,
# ADR-0015). Defaults to SELLER_LEGAL_NAME when empty.
COMPANY_DISPLAY_NAME=
SELLER_LEGAL_NAME=Tech Drona (DEV PLACEHOLDER)
# [REQUIRED in prod: api, worker-critical] Registered address printed on invoice PDFs.
# Production refuses the placeholder.
SELLER_ADDRESS=DEV PLACEHOLDER ADDRESS, Hyderabad, Telangana
# [OPTIONAL: api, workers] Invoice/GST document store: s3 (SeaweedFS locally, AWS S3 in prod)
# | memory (tests only; refused at startup in production)
COMMERCE_DOCUMENT_STORE=s3
# [REQUIRED in prod: api, webhooks] Payment webhook processing: inline (local/dev/tests: process
# right after ingest) | queue (hand off to the Celery `critical` queue, ADR-0006). Production
# must use queue: run_startup_checks refuses any other value in production (APP_ENV prod/production).
TD_COMMERCE_WEBHOOK_MODE=inline


# -----------------------------------------------------------------------------
# 10. Video — VdoCipher (ADR-0007)  (api)
# -----------------------------------------------------------------------------
# [REQUIRED: api] [SECRET] VdoCipher API secret
VDOCIPHER_API_SECRET=vdo_local_api_secret_REPLACE
# [OPTIONAL] API base URL
VDOCIPHER_API_BASE_URL=https://dev.vdocipher.com/api
# [OPTIONAL] local: stub returns a fake OTP so the player flow can be exercised offline
VDOCIPHER_MODE=stub


# -----------------------------------------------------------------------------
# 11. Code judge — judge-gateway (worker-judge ONLY)  (ADR-0005)
# -----------------------------------------------------------------------------
# worker-judge is a DB poller (`python -m app.modules.coding.worker`), not a Celery worker:
# it claims queued submissions from Postgres every --interval seconds. Celery wake-ups on the
# judge_* queues are opt-in only (TD_CODING_SEND_TASKS=1) and have no consumer by default.
# [REQUIRED: judge] fake | judge0_cloud | self_hosted
JUDGE_PROVIDER=fake
# [REQUIRED: judge when provider != fake] Judge0 endpoint
JUDGE0_BASE_URL=https://judge0.example.invalid
# (JUDGE0_URL is accepted as an alias of JUDGE0_BASE_URL)
# [REQUIRED: judge when provider = judge0_cloud] [SECRET] Judge0 Cloud API key
JUDGE0_API_KEY=judge0_local_key_REPLACE
# [OPTIONAL] Header name the provider expects for the key
JUDGE0_AUTH_HEADER=X-Auth-Token
# [REQUIRED: judge] Provider limits used to size the Redis token bucket (arch §9.4)
# [NOT READ YET] no code reads this today
JUDGE_RATE_LIMIT_PER_SECOND=5
JUDGE_DAILY_QUOTA=2000
# [OPTIONAL] Poll budget before judge_timeout (arch §9.4)
# [NOT READ YET] no code reads this today
JUDGE_POLL_BUDGET_SECONDS=30
# [REQUIRED: judge, api] KMS key wrapping hidden-test data keys (td-judge-testcases); "local" = dev key
# [NOT READ YET] no code reads this today
JUDGE_TESTCASE_KMS_KEY_ID=local
# [REQUIRED in prod: judge, api] [SECRET] AES-256-GCM keyring for hidden test-case data keys:
# TD_K_TESTCASE_KEY_V{n} = 64 hex chars, one per retained version (secret td/k_testcase/v{n}).
# Production refuses placeholders; non-production falls back to a dev key when unset.
# Rotation: add V{n+1}, bump ACTIVE_VERSION, then re-wrap (coding service rewrap job).
TD_K_TESTCASE_KEY_V1=local-testcase-aes-v1-REPLACE-with-64-hex
TD_K_TESTCASE_ACTIVE_VERSION=1
# Phase 2 only (self_hosted): callback HMAC and mTLS client certificate
# [SECRET]
# [NOT READ YET] no code reads this today
JUDGE_CALLBACK_HMAC_SECRET=
# [SECRET] paths to files mounted from Secrets Manager
# [NOT READ YET] no code reads this today
JUDGE_MTLS_CERT_PATH=
JUDGE_MTLS_KEY_PATH=
JUDGE_MTLS_CA_PATH=


# --- AI (app/modules/ai) --------------------------------------------------------------------
# [REQUIRED: ai] fake (dev/test only; production refuses it) | anthropic | disabled (AI off)
AI_PROVIDER=fake
# [REQUIRED: ai when provider = anthropic] [SECRET] Anthropic API key (never stored in the DB)
ANTHROPIC_API_KEY=anthropic_local_key_REPLACE
# [OPTIONAL] default model and the models admins may pick (comma-separated)
AI_DEFAULT_MODEL=claude-sonnet-5-5
AI_ALLOWED_MODELS=claude-sonnet-5-5,claude-haiku-5-5,claude-opus-5-5

# -----------------------------------------------------------------------------
# 12. Notifications — email (SES / Mailpit) and SMS (MSG91 or similar)
# -----------------------------------------------------------------------------
# [REQUIRED: worker-notifications] ses | smtp
EMAIL_PROVIDER=smtp
# [REQUIRED: worker-notifications] Verified sender
EMAIL_FROM_ADDRESS=no-reply@example.invalid
EMAIL_FROM_NAME=Tech Drona
# [OPTIONAL: SES] Configuration sets (transactional vs marketing)
SES_CONFIGURATION_SET_TRANSACTIONAL=td-transactional
SES_CONFIGURATION_SET_MARKETING=td-marketing
# Local Mailpit SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
# [REQUIRED: worker-notifications] console | msg91
SMS_PROVIDER=console
# [REQUIRED when SMS_PROVIDER=msg91] [SECRET] MSG91 auth key
MSG91_AUTH_KEY=msg91_local_key_REPLACE
# [OPTIONAL] MSG91 API base URL (override for tests only)
MSG91_BASE_URL=https://control.msg91.com/api/v5
# [REQUIRED when msg91] DLT-registered header (sender id) and principal entity id (TRAI DLT)
MSG91_SENDER_ID=TDRONA
MSG91_DLT_ENTITY_ID=1000000000000000000_REPLACE
# [REQUIRED when msg91] DLT template ids (one per approved template)
MSG91_TEMPLATE_ID_OTP=REPLACE_TEMPLATE_ID
MSG91_TEMPLATE_ID_SECURITY_NOTICE=REPLACE_TEMPLATE_ID
MSG91_TEMPLATE_ID_PAYMENT=REPLACE_TEMPLATE_ID
# [REQUIRED: worker-notifications] Hard daily SMS spend cap (INR) — SMS-pumping guard
# [NOT READ YET] no code reads this today
SMS_DAILY_SPEND_CAP_INR=2000
# [OPTIONAL] Comma-separated allowlist of numbers that may receive SMS (dev/staging only; empty = all in prod)
# [NOT READ YET] no code reads this today
SMS_RECIPIENT_ALLOWLIST=+910000000000
# [OPTIONAL] Email recipient allowlist for staging (domains or addresses)
# [NOT READ YET] no code reads this today
EMAIL_RECIPIENT_ALLOWLIST=example.invalid


# -----------------------------------------------------------------------------
# 13. Security integrations (api, worker-default)
# -----------------------------------------------------------------------------
# [OPTIONAL] HIBP k-anonymity range API (no key; fail open with log)
HIBP_RANGE_API_URL=https://api.pwnedpasswords.com/range/
# [NOT READ YET] no code reads this today
HIBP_TIMEOUT_SECONDS=2
# [OPTIONAL] Offline IP-intelligence DB path inside the container (refreshed monthly)
# [NOT READ YET] no code reads this today
IPINTEL_DB_PATH=/var/lib/td/ipintel/GeoLite2-ASN.mmdb
# [OPTIONAL: worker-default] [SECRET] Licence key used only to download the offline DB
# [NOT READ YET] no code reads this today
MAXMIND_LICENSE_KEY=maxmind_local_REPLACE
# [OPTIONAL: api] Trusted proxy hops for client IP extraction (CloudFront + ALB = 2)
TD_TRUSTED_PROXY_HOPS=0


# -----------------------------------------------------------------------------
# 14. Observability — error tracking (self-hosted GlitchTip)
#     Error tracking is self-hosted GlitchTip in AWS ap-south-1 (ADR-0014).
#     Sentry SaaS is NOT used: never put a sentry.io DSN in any environment.
# -----------------------------------------------------------------------------
# [OPTIONAL: all backend + web server] [SECRET] DSN of the self-hosted GlitchTip (internal
# ALB, ap-south-1; secret obs/glitchtip-dsn). The name SENTRY_DSN is kept only because the
# Sentry SDKs (sentry-sdk, @sentry/nextjs) read it; it must never point to sentry.io.
# Empty = disabled. Local example (profile errors-local): http://<key>@localhost:8001/1
SENTRY_DSN=
# [NOT READ YET] no code reads this today
SENTRY_ENVIRONMENT=local
# [OPTIONAL] Performance sampling (traces go to X-Ray via OTel; keep 0)
# [NOT READ YET] no code reads this today
SENTRY_TRACES_SAMPLE_RATE=0
# PII: send_default_pii=False; before_send scrubs cookies, Authorization, X-CSRF-Token,
# X-TD-* headers, bodies, query strings and IPs; user = internal user_id only (ADR-0014).


# -----------------------------------------------------------------------------
# 15. Web (Next.js BFF)  — server-side vars unless prefixed NEXT_PUBLIC_
#     NEXT_PUBLIC_* values are embedded in the browser bundle: NEVER put secrets there.
# -----------------------------------------------------------------------------
# [REQUIRED: web]
NODE_ENV=development
PORT=3000
# [OPTIONAL: web] Proxy timeout to api (ms)
TD_BFF_PROXY_TIMEOUT_MS=15000
# [OPTIONAL: web] Trusted proxy hops in front of the BFF for client-IP extraction
# (X-Forwarded-For read from the right, skipping this many entries appended by our own proxies;
# CloudFront -> ALB -> web = 1, and CloudFront-Viewer-Address is preferred when > 0). Same name
# as the api setting in section 13 — each service sets its own value in AWS; locally both are 0.
TD_TRUSTED_PROXY_HOPS=0
# [OPTIONAL: web] Browser-visible app name and public origin
NEXT_PUBLIC_APP_NAME=Tech Drona
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# [OPTIONAL: web] Main Tech Drona company website (header/footer links on public and auth pages,
# "Tech Drona website" in the portal account menu). Default https://35-244-50-26.sslip.io
# Also the course catalogue source: the web server reads <SITE_URL>/catalog.json (plus the public
# Firestore collection web_course_public via NEXT_PUBLIC_FIREBASE_PROJECT_ID/API_KEY), cached 5 min,
# for Explore courses (/app/courses) and the "Website catalogue" on /admin/courses.
NEXT_PUBLIC_SITE_URL=https://35-244-50-26.sslip.io
# [OPTIONAL: web] App version sent with client analytics events (default 0.1.0; set by CI)
NEXT_PUBLIC_APP_VERSION=0.1.0
# [OPTIONAL: web] Privacy-notice version recorded with signup consents; must match the API's
# current notice version (default 2026-11-01)
NEXT_PUBLIC_NOTICE_VERSION=2026-11-01
# [OPTIONAL: web] Comma-separated upload origins for the CSP connect-src (wins over the
# S3_ENDPOINT_URL / S3_BUCKET_UPLOADS derivation). Empty = derived.
TD_CSP_UPLOAD_ORIGINS=
# [OPTIONAL: web] Comma-separated VdoCipher video upload origins (studio direct upload to
# clientPayload.uploadLink) for CSP connect-src/form-action. Exact https origins only;
# wildcards are dropped. Empty = default https://vdo-ap-southeast.s3-accelerate.amazonaws.com
# (UNVERIFIED: confirm the uploadLink origin VdoCipher returns for our account region).
TD_CSP_VDOCIPHER_UPLOAD_ORIGINS=
# [OPTIONAL: web] Browser error reporting goes through the same-origin BFF tunnel
# POST /api/v1/_errors (rate-limited, no cookies forwarded) to the self-hosted GlitchTip,
# so the GlitchTip host is never exposed to browsers (ADR-0014). Empty = disabled.
NEXT_PUBLIC_ERRORS_TUNNEL=/api/v1/_errors
# [OPTIONAL: web] Browser DSN used only for the SDK envelope header (project id/key of the
# internal GlitchTip; never a sentry.io DSN). Empty = browser error reporting disabled.
NEXT_PUBLIC_SENTRY_DSN=
# [OPTIONAL: web] Analytics SDK schema version sent with events
NEXT_PUBLIC_ANALYTICS_SCHEMA_VERSION=1
# [OPTIONAL: web] Next.js telemetry off
NEXT_TELEMETRY_DISABLED=1


# -----------------------------------------------------------------------------
# 16. Local-only helpers (ignored outside APP_ENV=local)
# -----------------------------------------------------------------------------
# docker-compose host ports (defaults shown). Change them when the port is busy on the host and
# keep DATABASE_* / REDIS_* / S3_ENDPOINT_URL above consistent (docs/local-development.md §3.1).
TD_PG_HOST_PORT=5432
TD_REDIS_CACHE_HOST_PORT=6379
TD_REDIS_QUEUE_HOST_PORT=6380
TD_SMTP_HOST_PORT=1025
TD_MAILPIT_UI_HOST_PORT=8025
TD_S3_HOST_PORT=9000
# Compose profile `app` (containerised api / web)
TD_API_HOST_PORT=18000
TD_API_WEBHOOKS_HOST_PORT=18001
TD_WEB_HOST_PORT=13000
# Seed synthetic data on startup of the local stack
# [NOT READ YET] no code reads this today
TD_LOCAL_SEED=true
# Postgres superuser for the docker-compose init script only (creates td_* roles)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_postgres_pw_REPLACE
POSTGRES_DB=techdrona
# (Local S3 = SeaweedFS; its access key/secret live in infra/docker/s3/s3.json and match
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above. MinIO is no longer used.)


# -----------------------------------------------------------------------------
# 17. Firebase / Firestore backend (docs/firebase/MIGRATION-PLAN.md, docs/firebase/p0.md)
# -----------------------------------------------------------------------------
# Per-module persistence switch, read once at startup: TD_STORE_<MODULE>=postgres|firestore
# (default postgres for every module; unknown modules/values refuse to start). Example:
# TD_STORE_CATALOG=firestore
# [OPTIONAL: api, worker] Firebase project id. Real project: billing-f4fe3 ("TechDrona Full LMS"). With the emulator
# use a demo-* id (default demo-techdrona-lms) so nothing can ever reach the real project.
FIREBASE_PROJECT_ID=
# [SECRET-PATH: api, worker] Absolute path to the service-account JSON, OUTSIDE the repository,
# e.g. C:\Users\<you>\.secrets\techdrona-full-lms-sa.json. Required in production when any module is on
# Firestore; the startup gate refuses a path inside the repo. Never commit the key itself.
FIREBASE_SERVICE_ACCOUNT_FILE=
# [LOCAL/TEST: api] Firestore emulator (firebase.json: firestore 127.0.0.1:18080, auth :19099,
# UI :14000). Refused in production.
FIRESTORE_EMULATOR_HOST=
# [OPTIONAL: api] Named database; "(default)" unless the owner creates another one (F4).
FIRESTORE_DATABASE_ID=(default)


# -----------------------------------------------------------------------------
# 18. Firebase Auth (Google sign-in), Analytics and the Hosting showcase (docs/firebase/p1.md)
# -----------------------------------------------------------------------------
# [PUBLIC: web] Firebase web app config (Console > Project settings > Your apps > Web). These
# identify the project and are embedded in the browser; they are NOT secrets. Read by the web
# server at request time (no rebuild needed). Leave empty to hide Google sign-in/Analytics.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# [PUBLIC: web] GA4 measurement id (G-XXXXXXXXXX). Analytics loads only after the learner grants
# the "Product analytics" consent (analytics_product).
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# [OPTIONAL: api, web] Kill switch for "Continue with Google" (students only). false = hidden in
# the web app and POST /api/v1/auth/login/google answers 503 google_signin_unavailable.
TD_GOOGLE_SIGNIN_ENABLED=true
# [OPTIONAL: api] Firebase project whose ID tokens are accepted (token "aud"). Defaults to
# NEXT_PUBLIC_FIREBASE_PROJECT_ID, then FIREBASE_PROJECT_ID; demo-* (emulator) ids are refused.
TD_GOOGLE_SIGNIN_PROJECT_ID=
# [OPTIONAL: web] Kill switch for Firebase Analytics (false = never loaded, CSP hosts dropped).
TD_FIREBASE_ANALYTICS_ENABLED=true
# [OPTIONAL: build tool] Static showcase snapshot (apps/web/scripts/build-showcase.mjs).
TD_SHOWCASE_SOURCE=http://localhost:13000
TD_SHOWCASE_CONTACT_EMAIL=info@techdrona.com
TD_SHOWCASE_LIVE_URL=https://techdrona.in

# =============================================================================
# 19. College Data Portal (apps/college-data/portal, docs/college-data-portal.md)
# =============================================================================
# Served by the web BFF at /college-portal/* and opened from Admin > College Data Portal
# (/admin/college-data). Every request is checked against the LMS admin session; the BFF then
# calls the portal with this shared secret and the admin's name. The portal container reads the
# same value as PORTAL_PROXY_SECRET and refuses any request without it (except /api/health).
# [REQUIRED: web, college-portal; also locally] >= 32 random chars (openssl rand -base64 48).
TD_COLLEGE_PORTAL_SECRET=
# [OPTIONAL: web] Internal URL of the portal server. Default outside production:
# http://127.0.0.1:4173 (scripts/run-college-portal.ps1). Compose: http://college-portal:4173
TD_COLLEGE_PORTAL_URL=

# 20. DEMO ONLY owner override [api]: comma-separated e-mails that sign in with password only (no
#     mandatory MFA, no new-device code). Ignored when APP_ENV is production. Leave empty.
TD_MFA_EXEMPT_EMAILS=

# --- Admissions (website course registrations + manual UPI verification; apps/api/app/modules/admissions)
# Website origins allowed to call the LMS public admissions bridge (/api/public/admissions/*, web BFF).
# Comma list, exact origins, no wildcard. Empty = TD_WEBSITE_URL, else NEXT_PUBLIC_SITE_URL.
TD_ADMISSIONS_ALLOWED_ORIGINS=
